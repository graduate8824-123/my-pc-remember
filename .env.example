# MY PC REMEMBERS - Environment Configuration
# Privacy-first, local AI memory for personal computers

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Paths
DATABASE_PATH=./data/app.db
VECTOR_INDEX_PATH=./data/faiss.index
METADATA_STORE_PATH=./data/metadata.json

# Embeddings
# Options: "fastembed" (local ONNX, small, fast), "hash" (deterministic offline lightweight), "sentence-transformers"
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Retrieval & Search
TOP_K=8
SIMILARITY_THRESHOLD=0.25

# Local LLM Provider
# Options: "mock" (for testing/development), "ollama" (for local Ollama instance)
LLM_PROVIDER=mock
LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Hardware & Inference Target
# Options: "cpu" (Apple Silicon Mac or standard CPU), "snapdragon" (Snapdragon X Elite / NPU target)
INFERENCE_TARGET=cpu
